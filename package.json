{
  "name": "react-angpao-rain",
  "version": "0.1.0",
  "description": "Red envelope (angpao) rain mini game for React, powered by Phaser 3",
  "keywords": [
    "react",
    "typescript",
    "phaser",
    "game",
    "angpao",
    "red-envelope"
  ],
  "author": "garychien",
  "type": "module",
  "license": "MIT",
  "module": "./dist/react-angpao-rain.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-angpao-rain.es.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "NODE_ENV=development vite build -w",
    "build:clear": "rm -rf ./dist",
    "prepublishOnly": "run-s build",
    "build": "run-s build:clear && tsc && vite build",
    "lint:fix": "eslint ./src --fix",
    "cz": "git-cz",
    "test": "jest",
    "theme:generate": "node scripts/themes/default.mjs && node scripts/themes/christmas.mjs",
    "theme:check": "node scripts/themes/check.mjs",
    "gitlog": "git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cblueby %an %Cgreen(%cr)%Creset'",
    "release": "standard-version --release-as",
    "release:major": "standard-version -r major",
    "release:minor": "standard-version -r minor",
    "release:patch": "standard-version -r patch",
    "release:alpha": "standard-version --prerelease alpha"
  },
  "peerDependencies": {
    "phaser": "^3.90.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-ts": "^3.0.1",
    "@swc/core": "1.11.24",
    "@swc/jest": "^0.2.27",
    "@types/jest": "^29.5.0",
    "@types/node": "20.17.32",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "cz-conventional-changelog": "3.3.0",
    "cz-git": "1.6.1",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "npm-run-all": "^4.1.5",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup-plugin-visualizer": "^5.9.0",
    "sass": "^1.87.0",
    "sharp": "0.33.5",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-eslint": "^1.8.1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "resolutions": {
    "@swc/core": "1.11.24"
  },
  "packageManager": "yarn@1.22.22"
}
